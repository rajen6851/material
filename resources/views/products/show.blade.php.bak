                            <!-- CUSTOM SIZE -->

                            <div
                                x-show="sizeMode === 'custom'"
                                x-cloak
                                class="grid grid-cols-2 gap-3"
                            >

                                <div>

                                    <label class="text-[10px] font-bold text-slate-400 uppercase">
                                        Width (mm)
                                    </label>

                                    <input
                                        type="number"
                                        min="1"
                                        step="1"
                                        x-model.number="customWidth"
                                        class="w-full border-slate-300 rounded-xl text-sm p-3 mt-1 focus:border-teal-500 focus:ring-0"
                                    >

                                </div>


                                <div>

                                    <label class="text-[10px] font-bold text-slate-400 uppercase">
                                        Height (mm)
                                    </label>

                                    <input
                                        type="number"
                                        min="1"
                                        step="1"
                                        x-model.number="customHeight"
                                        class="w-full border-slate-300 rounded-xl text-sm p-3 mt-1 focus:border-teal-500 focus:ring-0"
                                    >

                                </div>

                            </div>

                        </div>



                        <!-- ROOM AREA -->

                        <div>

                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">
                                What's the total area you're planning to tile?
                            </label>


                            <div class="grid grid-cols-2 gap-3">


                                <div>

                                    <input
                                        type="number"
                                        min="0"
                                        step="0.1"
                                        x-model.number="length"
                                        placeholder="Length"
                                        class="w-full border-slate-300 rounded-xl text-sm p-3 focus:border-teal-500 focus:ring-0"
                                    >

                                    <span class="text-[10px] text-slate-400 font-semibold">
                                        Length (ft)
                                    </span>

                                </div>


                                <div>

                                    <input
                                        type="number"
                                        min="0"
                                        step="0.1"
                                        x-model.number="width"
                                        placeholder="Width"
                                        class="w-full border-slate-300 rounded-xl text-sm p-3 focus:border-teal-500 focus:ring-0"
                                    >

                                    <span class="text-[10px] text-slate-400 font-semibold">
                                        Width (ft)
                                    </span>

                                </div>

                            </div>

                        </div>



                        <!-- TILES PER BOX -->

                        <div>

                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">
                                Tiles per box
                            </label>

                            <input
                                type="number"
                                min="1"
                                step="1"
                                x-model.number="tilesPerBox"
                                class="w-full border-slate-300 rounded-xl text-sm p-3 focus:border-teal-500 focus:ring-0"
                            >

                            <p class="text-[10px] text-slate-400 mt-1">
                                Number of tiles included in one box.
                            </p>

                        </div>



                        <!-- PRICE PER BOX -->

                        <div>

                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">
                                Price per box
                            </label>

                            <div class="relative">

                                <span class="absolute left-3 top-3 text-sm font-bold text-slate-400">
                                    ₹
                                </span>

                                <input
                                    type="number"
                                    min="0"
                                    step="0.01"
                                    x-model.number="pricePerBox"
                                    class="w-full border-slate-300 rounded-xl text-sm p-3 pl-8 focus:border-teal-500 focus:ring-0"
                                >

                            </div>

                        </div>



                        <!-- CALCULATE -->

                        <button
                            type="button"
                            @click="calculate()"
                            class="w-full bg-teal-600 hover:bg-teal-700 text-white font-bold py-3 rounded-xl transition text-sm"
                        >
                            Calculate
                        </button>

                    </div>



                    <!-- =========================================== -->
                    <!-- RIGHT RESULT -->
                    <!-- =========================================== -->

                    <div
                        class="lg:col-span-2 bg-slate-50 border border-slate-200 rounded-2xl p-5 sm:p-6"
                        x-show="calculated"
                        x-cloak
                    >


                        <!-- RESULT HEADER -->

                        <div class="mb-5">

                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                                Your Tiling Project Estimate
                            </p>

                            <p class="text-sm text-slate-500 mt-1">
                                Based on your selected tile type, tile size and area.
                            </p>

                        </div>



                        <!-- TILE INFO -->

                        <div class="bg-white border rounded-xl p-4 mb-4">

                            <div class="grid grid-cols-2 gap-4">


                                <div>

                                    <p class="text-[10px] font-bold text-slate-400 uppercase">
                                        Tile Type
                                    </p>

                                    <p
                                        class="text-base font-black text-slate-900 mt-1"
                                        x-text="tileType"
                                    ></p>

                                </div>


                                <div class="text-right">

                                    <p class="text-[10px] font-bold text-slate-400 uppercase">
                                        Tile Size
                                    </p>

                                    <p class="text-base font-black text-slate-900 mt-1">

                                        <span x-text="tileWidth"></span>

                                        ×

                                        <span x-text="tileHeight"></span>

                                        <span class="text-xs font-semibold text-slate-400">
                                            mm
                                        </span>

                                    </p>

                                </div>

                            </div>

                        </div>



                        <!-- RESULT CARDS -->

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">


                            <!-- TOTAL AREA -->

                            <div class="bg-white border rounded-xl p-5">

                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                    Total Area
                                </p>

                                <p class="text-2xl font-black text-slate-900 mt-1">

                                    <span x-text="roomArea.toFixed(2)"></span>

                                    <span class="text-xs font-semibold text-slate-400">
                                        sq.ft
                                    </span>

                                </p>

                            </div>



                            <!-- TILE AREA -->

                            <div class="bg-white border rounded-xl p-5">

                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                    One Tile Area
                                </p>

                                <p class="text-2xl font-black text-slate-900 mt-1">

                                    <span x-text="tileAreaSqft.toFixed(3)"></span>

                                    <span class="text-xs font-semibold text-slate-400">
                                        sq.ft
                                    </span>

                                </p>

                            </div>



                            <!-- TILES NEEDED -->

                            <div class="bg-white border rounded-xl p-5">

                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                    Tiles Needed
                                </p>

                                <p class="text-2xl font-black text-teal-700 mt-1">

                                    <span x-text="tilesNeeded"></span>

                                    <span class="text-xs font-semibold text-slate-400">
                                        tiles
                                    </span>

                                </p>

                            </div>



                            <!-- BOXES -->

                            <div class="bg-white border rounded-xl p-5">

                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                    Boxes Needed
                                </p>

                                <p class="text-2xl font-black text-teal-700 mt-1">

                                    <span x-text="boxesNeeded"></span>

                                    <span class="text-xs font-semibold text-slate-400">
                                        boxes
                                    </span>

                                </p>

                            </div>



                            <!-- COST -->

                            <div
                                class="sm:col-span-2 bg-white border rounded-xl p-5"
                                x-show="costEstimate > 0"
                                x-cloak
                            >

                                <div class="flex items-center justify-between gap-4">

                                    <div>

                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                            Estimated Material Cost
                                        </p>

                                        <p class="text-xs text-slate-400 mt-1">
                                            Based on price per box
                                        </p>

                                    </div>

                                    <p class="text-2xl font-black text-slate-900">

                                        ₹<span
                                            x-text="costEstimate.toLocaleString('en-IN', {
                                                maximumFractionDigits: 0
                                            })"
                                        ></span>

                                    </p>

                                </div>

                            </div>

                        </div>



                        <!-- CALCULATION -->

                        <div class="mt-5 bg-teal-50 border border-teal-100 rounded-xl px-4 py-3">

                            <p class="text-xs text-teal-800 leading-relaxed">

                                <strong>
                                    Calculation:
                                </strong>

                                <span x-text="roomArea.toFixed(2)"></span>
                                sq.ft ÷

                                <span x-text="tileAreaSqft.toFixed(3)"></span>
                                sq.ft per tile =

                                <strong>
                                    <span x-text="tilesNeeded"></span>
                                    tiles
                                </strong>

                                →

                                approximately

                                <strong>
                                    <span x-text="boxesNeeded"></span>
                                    boxes
                                </strong>.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        @endif

    </div>

</x-app-layout>

