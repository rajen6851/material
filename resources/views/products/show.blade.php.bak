                                    class="cursor-pointer border rounded-xl p-3 text-center transition-all"
                                    :class="tileType === 'Wall Tile'
                                        ? 'border-teal-600 bg-teal-50 text-teal-700'
                                        : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'"
                                >

                                    <input
                                        type="radio"
                                        value="Wall Tile"
                                        x-model="tileType"
