        @if($isTiles)

            <div
                class="mt-12 bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm"
                x-data="{

                    tileType: '{{ $product->sub_category ?? 'Floor Tile' }}',

                    sizeMode: 'product',

                    productWidth: {{ (float) ($product->width_mm ?: 600) }},

                    productHeight: {{ (float) ($product->height_mm ?: 600) }},

                    customWidth: 600,

                    customHeight: 600,

                    length: 12,

                    width: 10,

                    tilesPerBox: {{ (int) ($product->pieces_per_box ?: 2) }},

                    pricePerBox: {{ (float) ($product->price_per_box ?: 0) }},

                    calculated: false,


                    get tileWidth() {

                        return this.sizeMode === 'product'
                            ? this.productWidth
                            : this.customWidth;

                    },


                    get tileHeight() {

                        return this.sizeMode === 'product'
                            ? this.productHeight
                            : this.customHeight;

                    },


                    get tileAreaSqft() {

                        if (
                            this.tileWidth <= 0 ||
                            this.tileHeight <= 0
                        ) {
                            return 0;
                        }

                        return (
                            (this.tileWidth / 304.8) *
                            (this.tileHeight / 304.8)
                        );

                    },


                    get roomArea() {

                        if (
                            this.length <= 0 ||
                            this.width <= 0
                        ) {
                            return 0;
                        }

                        return this.length * this.width;

                    },


                    get tilesNeeded() {

                        if (
                            this.tileAreaSqft <= 0 ||
                            this.roomArea <= 0
                        ) {
                            return 0;
                        }

                        return Math.ceil(
                            this.roomArea / this.tileAreaSqft
                        );

                    },


                    get boxesNeeded() {

                        if (
                            this.tilesPerBox <= 0 ||
                            this.tilesNeeded <= 0
                        ) {
                            return 0;
                        }

                        return Math.ceil(
                            this.tilesNeeded / this.tilesPerBox
                        );

                    },


                    get costEstimate() {

                        if (
                            this.pricePerBox <= 0 ||
                            this.boxesNeeded <= 0
                        ) {
                            return 0;
                        }

                        return (
                            this.boxesNeeded *
                            this.pricePerBox
                        );

                    },


                    calculate() {

                        this.calculated = true;

                    }

                }"
            >


                <!-- HEADER -->

                <div>

                    <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
