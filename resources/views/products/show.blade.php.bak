<!-- MAIN PRODUCT IMAGE - HOVER ZOOM -->
<!-- ========================================= -->

<div
    class="bg-slate-50 rounded-2xl border aspect-square relative overflow-hidden group cursor-zoom-in"
    x-data="{
        zoom: false,
        originX: 50,
        originY: 50,

                moveImage(event) {
            const rect = event.currentTarget.getBoundingClientRect();
            
            // Handle both mouse and touch events
            let clientX = event.clientX;
            let clientY = event.clientY;
            
            if (event.touches && event.touches.length > 0) {
                clientX = event.touches[0].clientX;
                clientY = event.touches[0].clientY;
            }

            this.originX = ((clientX - rect.left) / rect.width) * 100;
            this.originY = ((clientY - rect.top) / rect.height) * 100;
        },

        resetZoom() {
            this.zoom = false;
            this.originX = 50;
            this.originY = 50;
        }
    }"
        @mouseenter="zoom = true"
    @mousemove="moveImage($event)"
    @mouseleave="resetZoom()"
    @touchstart="zoom = true; moveImage($event)"
    @touchmove="moveImage($event)"
    @touchend="resetZoom()"
>

