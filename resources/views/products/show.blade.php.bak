                    class="max-h-full max-w-full object-contain rounded-xl select-none pointer-events-none"

                    :style="`
                        transform: scale(${zoom ? 1.8 : 1});
                        transform-origin: ${originX}% ${originY}%;
                        transition: transform 0.25s ease-out;
                    `"
                >

            </div>

        </template>

