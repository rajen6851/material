                                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">

                                    <p class="text-[10px] font-bold text-slate-400 uppercase">
                                        Product Tile Size
                                    </p>

                                    <p class="text-lg font-black text-slate-900 mt-1">

                                        <span x-text="productWidth"></span>

